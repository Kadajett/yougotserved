{
  "format": 1,
  "id": "greenhouse",
  "name": "Greenhouse",
  "description": "Inspect and submit public Greenhouse job applications with your own browser session.",
  "version": "0.1.1",
  "homepage": "https://github.com/Kadajett/yougotserved",
  "origins": [
    "https://job-boards.greenhouse.io",
    "https://job-boards.eu.greenhouse.io",
    "https://boards.greenhouse.io"
  ],
  "capabilities": ["navigate", "read", "interact", "upload"],
  "uploads": {
    "allowedExtensions": ["pdf", "doc", "docx"],
    "maxBytes": 10485760
  },
  "tools": {
    "inspect_application": {
      "description": "Read a Greenhouse application form. Returns every field with its id, label and control type.",
      "returns": "The job title and a list of fields. Feed the field ids back to apply.",
      "risk": "read",
      "capabilities": ["navigate", "read"],
      "requiresConfirm": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Public Greenhouse job URL"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum fields to return",
            "default": 50,
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": ["url"]
      },
      "steps": [
        {
          "goto": "{{url}}",
          "until": {
            "selector": "#application-form"
          }
        },
        {
          "click": "button[aria-label='Apply']",
          "optional": true,
          "until": {
            "selector": "#application-form"
          }
        },
        {
          "assert": {
            "selector": "#application-form",
            "code": "not_found",
            "message": "Greenhouse showed no application form.",
            "hint": "The posting may be closed."
          }
        },
        {
          "extract": {
            "each": "#application-form .field-wrapper, #application-form .eeoc__question__wrapper",
            "limit": "{{limit}}",
            "fields": {
              "fieldId": {
                "selector": "input[id], textarea[id], select[id]",
                "attr": "id",
                "fallback": null
              },
              "label": {
                "selector": "label",
                "fallback": null
              },
              "inputType": {
                "selector": "input",
                "attr": "type",
                "fallback": null
              },
              "role": {
                "selector": "input, textarea, select",
                "attr": "role",
                "fallback": null
              },
              "hasTextarea": {
                "selector": "textarea",
                "exists": true
              },
              "hasFile": {
                "selector": "input[type='file']",
                "exists": true
              },
              "required": {
                "selector": "[aria-required='true'], input[required], textarea[required]",
                "exists": true
              }
            }
          }
        }
      ]
    },
    "apply": {
      "description": "Fill and submit a Greenhouse application. This sends the application and cannot be undone.",
      "returns": "The page Greenhouse shows after submitting.",
      "risk": "irreversible",
      "capabilities": ["navigate", "read", "interact", "upload"],
      "requiresConfirm": true,
      "timeoutMs": 240000,
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Public Greenhouse job URL"
          },
          "firstName": {
            "type": "string",
            "description": "Applicant first name"
          },
          "lastName": {
            "type": "string",
            "description": "Applicant last name"
          },
          "preferredName": {
            "type": "string",
            "description": "Preferred first name"
          },
          "email": {
            "type": "string",
            "description": "Applicant email"
          },
          "phone": {
            "type": "string",
            "description": "Applicant phone"
          },
          "resume": {
            "type": "object",
            "description": "Resume file to attach"
          },
          "answers": {
            "type": "array",
            "description": "One entry per extra question, from inspect_application",
            "items": {
              "type": "object",
              "properties": {
                "fieldId": {
                  "type": "string",
                  "description": "Field id from inspect"
                },
                "value": {
                  "type": "string",
                  "description": "The answer"
                }
              },
              "required": ["fieldId", "value"]
            }
          }
        },
        "required": ["url", "firstName", "lastName", "email", "resume"]
      },
      "steps": [
        {
          "goto": "{{url}}",
          "until": {
            "selector": "#application-form"
          }
        },
        {
          "click": "button[aria-label='Apply']",
          "optional": true,
          "until": {
            "selector": "#first_name"
          }
        },
        {
          "assert": {
            "selector": "#first_name",
            "code": "not_found",
            "message": "Greenhouse showed no application form.",
            "hint": "The posting may be closed."
          }
        },
        {
          "fill": "#first_name",
          "value": "{{firstName}}"
        },
        {
          "fill": "#last_name",
          "value": "{{lastName}}"
        },
        {
          "fill": "#preferred_name",
          "value": "{{preferredName}}",
          "optional": true
        },
        {
          "fill": "#email",
          "value": "{{email}}"
        },
        {
          "fill": "#phone",
          "value": "{{phone}}",
          "optional": true
        },
        {
          "upload": {
            "selector": "#resume",
            "file": "{{resume}}"
          }
        },
        {
          "forEach": "{{answers}}",
          "as": "answer",
          "steps": [
            {
              "fill": "input#{{answer.fieldId}}, textarea#{{answer.fieldId}}",
              "value": "{{answer.value}}",
              "optional": true
            },
            {
              "select": "select#{{answer.fieldId}}",
              "value": "{{answer.value}}",
              "optional": true
            }
          ]
        },
        {
          "click": "#application-form button[type='submit']",
          "until": {
            "selectorGone": "#first_name"
          }
        },
        {
          "extract": {
            "fields": {
              "confirmation": {
                "selector": "main, body"
              }
            }
          }
        }
      ]
    }
  }
}
