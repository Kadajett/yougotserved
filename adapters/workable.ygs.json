{
  "format": 1,
  "id": "workable",
  "name": "Workable",
  "description": "Inspect and submit public Workable job applications with your own browser session.",
  "version": "0.1.0",
  "homepage": "https://github.com/Kadajett/yougotserved",
  "origins": ["https://apply.workable.com"],
  "capabilities": ["navigate", "read", "interact", "upload"],
  "uploads": { "allowedExtensions": ["pdf", "doc", "docx"], "maxBytes": 10485760 },
  "tools": {
    "inspect_application": {
      "description": "Read a Workable application form. Returns the standard controls and each custom question.",
      "returns": "Which standard fields exist, plus the custom questions with their field names.",
      "risk": "read",
      "capabilities": ["navigate", "read"],
      "requiresConfirm": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "description": "Public Workable job URL" },
          "limit": {
            "type": "integer",
            "description": "Maximum questions to return",
            "default": 40,
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": ["url"]
      },
      "steps": [
        { "goto": "{{url}}", "until": { "selector": "main form" } },
        {
          "assert": {
            "selector": "main form",
            "code": "not_found",
            "message": "Workable showed no application form.",
            "hint": "The posting may be closed."
          }
        },
        {
          "extract": {
            "fields": {
              "firstName": { "selector": "input[data-ui='firstname']", "exists": true },
              "lastName": { "selector": "input[data-ui='lastname']", "exists": true },
              "email": { "selector": "input[data-ui='email']", "exists": true },
              "phone": { "selector": "input[name='phone']", "exists": true },
              "resume": {
                "selector": "form input[type='file'][data-ui='resume']",
                "exists": true
              },
              "coverLetter": {
                "selector": "textarea[data-ui='cover_letter']",
                "exists": true
              }
            }
          },
          "as": "standard"
        },
        {
          "extract": {
            "each": "form label:has(input[data-ui^='CA_'], textarea[data-ui^='CA_'])",
            "limit": "{{limit}}",
            "fields": {
              "fieldName": {
                "selector": "input[data-ui^='CA_'], textarea[data-ui^='CA_']",
                "attr": "data-ui",
                "fallback": null
              },
              "label": {},
              "required": { "selector": "input[required], textarea[required]", "exists": true }
            }
          },
          "as": "questions"
        }
      ]
    },
    "apply": {
      "description": "Fill and submit a Workable application. This sends the application and cannot be undone.",
      "returns": "The page Workable shows after submitting.",
      "risk": "irreversible",
      "capabilities": ["navigate", "read", "interact", "upload"],
      "requiresConfirm": true,
      "timeoutMs": 240000,
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "description": "Public Workable job URL" },
          "firstName": { "type": "string", "description": "Applicant first name" },
          "lastName": { "type": "string", "description": "Applicant last name" },
          "email": { "type": "string", "description": "Applicant email" },
          "phone": { "type": "string", "description": "Applicant phone" },
          "coverLetter": { "type": "string", "description": "Cover letter text" },
          "resume": { "type": "object", "description": "Resume file to attach" },
          "answers": {
            "type": "array",
            "description": "One entry per custom question, from inspect_application",
            "items": {
              "type": "object",
              "properties": {
                "fieldName": { "type": "string", "description": "Field name from inspect" },
                "value": { "type": "string", "description": "The answer" }
              },
              "required": ["fieldName", "value"]
            }
          }
        },
        "required": ["url", "firstName", "lastName", "email", "resume"]
      },
      "steps": [
        { "goto": "{{url}}", "until": { "selector": "input[data-ui='firstname']" } },
        {
          "assert": {
            "selector": "form button[type='submit'][data-ui='apply-button']",
            "code": "not_found",
            "message": "Workable showed no apply button, so this posting is not accepting applications.",
            "hint": "Check the posting is still open."
          }
        },
        {
          "upload": {
            "selector": "form input[type='file'][data-ui='resume']",
            "file": "{{resume}}"
          }
        },
        { "fill": "input[data-ui='firstname']", "value": "{{firstName}}" },
        { "fill": "input[data-ui='lastname']", "value": "{{lastName}}" },
        { "fill": "input[data-ui='email']", "value": "{{email}}" },
        { "fill": "input[name='phone']", "value": "{{phone}}", "optional": true },
        {
          "fill": "textarea[data-ui='cover_letter']",
          "value": "{{coverLetter}}",
          "optional": true
        },
        {
          "forEach": "{{answers}}",
          "as": "answer",
          "steps": [
            {
              "fill": "input[data-ui='{{answer.fieldName}}'], textarea[data-ui='{{answer.fieldName}}']",
              "value": "{{answer.value}}",
              "optional": true
            }
          ]
        },
        {
          "click": "form button[type='submit'][data-ui='apply-button']",
          "until": { "selectorGone": "input[data-ui='firstname']" }
        },
        { "extract": { "fields": { "confirmation": { "selector": "main, body" } } } }
      ]
    }
  }
}
