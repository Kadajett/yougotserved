{
  "format": 1,
  "id": "hackernews",
  "name": "Hacker News",
  "description": "Read the front page, a story's comments, and search, without loading whole pages into context.",
  "version": "0.1.0",
  "homepage": "https://news.ycombinator.com",
  "origins": ["https://news.ycombinator.com"],
  "capabilities": ["navigate", "read"],
  "tools": {
    "top_stories": {
      "description": "Read the Hacker News front page. Returns rank, title, url, score, author and comment count for each story.",
      "returns": "A list of stories, newest ranking first.",
      "risk": "read",
      "capabilities": ["navigate", "read"],
      "requiresConfirm": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "How many stories to return",
            "default": 20,
            "minimum": 1,
            "maximum": 30
          },
          "page": {
            "type": "string",
            "description": "Which list to read",
            "enum": ["news", "newest", "best", "ask", "show"],
            "default": "news"
          }
        }
      },
      "steps": [
        {
          "goto": "https://news.ycombinator.com/{{page}}",
          "until": { "selector": "tr.athing" }
        },
        {
          "extract": {
            "each": "tr.athing",
            "limit": "{{limit}}",
            "fields": {
              "id": { "attr": "id" },
              "rank": { "selector": ".rank", "number": true },
              "title": ".titleline > a",
              "url": { "selector": ".titleline > a", "prop": "href" },
              "site": { "selector": ".sitestr", "fallback": null },
              "score": { "selector": ".score", "number": true, "from": "next", "fallback": 0 },
              "by": { "selector": ".hnuser", "from": "next", "fallback": null },
              "age": { "selector": ".age", "from": "next", "fallback": null },
              "comments": {
                "selector": "a[href^='item?id=']:last-of-type",
                "number": true,
                "from": "next",
                "fallback": 0
              }
            }
          }
        }
      ]
    },
    "read_comments": {
      "description": "Read the comments on one Hacker News story. Give it the story id from top_stories.",
      "returns": "The story, then a list of comments with author, age and text.",
      "risk": "read",
      "capabilities": ["navigate", "read"],
      "requiresConfirm": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Story id, e.g. \"49224294\"" },
          "limit": {
            "type": "integer",
            "description": "How many comments to return",
            "default": 25,
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": ["id"]
      },
      "steps": [
        {
          "goto": "https://news.ycombinator.com/item?id={{id|url}}",
          "until": { "selector": ".fatitem" }
        },
        {
          "extract": {
            "each": "tr.comtr",
            "limit": "{{limit}}",
            "fields": {
              "by": ".hnuser",
              "age": ".age",
              "indent": { "selector": ".ind", "attr": "indent", "number": true, "fallback": 0 },
              "text": ".commtext"
            }
          }
        }
      ]
    },
    "search": {
      "description": "Search Hacker News stories by keyword, through the site's own search page.",
      "returns": "A list of matching stories with title, url and score.",
      "risk": "read",
      "capabilities": ["navigate", "read"],
      "requiresConfirm": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "What to search for" },
          "limit": {
            "type": "integer",
            "description": "How many results to return",
            "default": 20,
            "minimum": 1,
            "maximum": 30
          }
        },
        "required": ["query"]
      },
      "steps": [
        {
          "goto": "https://news.ycombinator.com/from?site={{query|url}}",
          "until": { "selector": "tr.athing" }
        },
        {
          "extract": {
            "each": "tr.athing",
            "limit": "{{limit}}",
            "fields": {
              "id": { "attr": "id" },
              "title": ".titleline > a",
              "url": { "selector": ".titleline > a", "prop": "href" },
              "score": { "selector": ".score", "number": true, "from": "next", "fallback": 0 },
              "by": { "selector": ".hnuser", "from": "next", "fallback": null }
            }
          }
        }
      ]
    }
  }
}
