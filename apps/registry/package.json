{
  "name": "@yougotserved/registry",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:local": "wrangler d1 execute yougotserved-registry --local --file=schema.sql",
    "db:remote": "wrangler d1 execute yougotserved-registry --remote --file=schema.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "@yougotserved/adapter-sdk": "workspace:*",
    "@yougotserved/blocklist": "workspace:*",
    "@yougotserved/moderation": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.0.0",
    "wrangler": "^4.120.0"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
