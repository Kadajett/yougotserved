{
  "name": "@yougotserved/adapter-sdk",
  "version": "0.1.0",
  "description": "Define compact, site-specific browser tools that run in your own authenticated browser session.",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "./dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "lint": "npx eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.{ts,json}'"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^22.15.3",
    "jsdom": "^26.0.0",
    "tsup": "^8.4.0",
    "vitest": "^3.0.0"
  }
}
